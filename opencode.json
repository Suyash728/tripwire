{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*openapi.yaml", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },

    { "action": "shell", "resource": "git push * main", "effect": "deny" },
    { "action": "shell", "resource": "git push * main *", "effect": "deny" },
    { "action": "shell", "resource": "git push *:main", "effect": "deny" },
    { "action": "shell", "resource": "git push *:main *", "effect": "deny" },
    { "action": "shell", "resource": "git push * master", "effect": "deny" },
    { "action": "shell", "resource": "git push * master *", "effect": "deny" },
    { "action": "shell", "resource": "git push *:master", "effect": "deny" },
    { "action": "shell", "resource": "git push *:master *", "effect": "deny" },

    { "action": "shell", "resource": "cat *.env*", "effect": "deny" },
    { "action": "shell", "resource": "* .env", "effect": "deny" },
    { "action": "shell", "resource": "* .env.local*", "effect": "deny" },
    { "action": "shell", "resource": "* .env.production*", "effect": "deny" },
    { "action": "shell", "resource": "* .env.example*", "effect": "allow" }
  ]
}
