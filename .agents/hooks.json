{
  "repo-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content|multi_replace_file_content|grep_search",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"$(git rev-parse --show-toplevel)/.agents/hooks/guard.sh\"'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
