GROQ_API_KEY=
GEMINI_API_KEY=
# Tier 3 (local vLLM on the desktop; SGLang owns :8000, vLLM is :8001)
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=nvidia/Qwen3-14B-NVFP4
PRIVACY_MODE=0
# Supabase (optional). Unset = runs stay in memory. Set both AND send a signed-in user's JWT
# (Authorization: Bearer ...) to persist runs under Row Level Security. See docs/SUPABASE.md.
SUPABASE_URL=
# Publishable key (sb_publishable_...): safe to expose; only reaches what RLS allows.
# The legacy name SUPABASE_ANON_KEY is still read as a fallback (Supabase deprecates anon keys by end of 2026).
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_..., formerly service_role) BYPASSES RLS. Admin scripts only: never on request
# paths, never in the frontend, never NEXT_PUBLIC_*. The app does not read it.
# SUPABASE_SECRET_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/webhook/notify
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787
